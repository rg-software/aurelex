<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen search widget. The whole bar is tappable: it opens the app's
     search screen (matching the shipped app's design D2 approach — RemoteViews
     widgets cannot reliably capture typed text). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#CC333333"
    android:foreground="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/widget_search_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="Search Aurelex"
        android:textColor="#ffffff"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="🔍"
        android:textSize="18sp" />
</LinearLayout>
