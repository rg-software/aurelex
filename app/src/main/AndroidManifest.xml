<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".AurelexApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Aurelex"
        android:supportsRtl="true"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Look up in Aurelex" from other apps' share sheets -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Explicit lookup intent, e.g. aurelex://lookup?word=<word> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="aurelex" android:host="lookup" />
            </intent-filter>
            <!-- Selection-toolbar lookup: "Look up in Aurelex" on selected text -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          The dictionary engine (which links Qt android libs) runs in its own
          process so the Compose UI process never dlopens Qt. The UI talks to
          it via EngineClient over a local socket (EngineService).
        -->
        <service
            android:name=".EngineService"
            android:process=":engine"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Quick Settings tile: copies the clipboard text and opens the article.
             External intents targeting the tile land here; the label/icon are the
             standard TileService attributes (no separate meta-data resource exists
             for a QS tile). -->
        <service
            android:name=".QuickLookupTileService"
            android:label="@string/quick_lookup_tile_label"
            android:icon="@drawable/ic_tile_lookup"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home-screen search widget: a word entered in the widget is looked up
             by MainActivity via the SEARCH action. -->
        <receiver
            android:name=".AurelexSearchWidget"
            android:label="@string/widget_search_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_info" />
        </receiver>
    </application>
</manifest>