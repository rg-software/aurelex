<?xml version="1.0" encoding="utf-8"?>
<!-- Widget search field. The whole bar is tappable: it fires the SEARCH
     intent at MainActivity (design D2), which opens the in-app search screen.
     No EditText: RemoteViews widgets cannot capture typed text, and an
     EditText fails to inflate on many launchers ("cannot load widget"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:foreground="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/widget_search_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/widget_search_hint" />

    <TextView
        android:id="@+id/widget_search_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/widget_search_hint"
        android:textColor="#00695B"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>