<?xml version="1.0"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.aurelex.pocket.dictionary"
    android:installLocation="auto"
    android:versionCode="1"
    android:versionName="0.0.1">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Bulk FTS indexing (bulk-fts-indexing): lets the IndexingService run
         as a foreground service so a long index build survives the app being
         backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- The theme is what makes the launch starting window ours to paint: with
             "minimal" style extraction and no android:theme, the platform default
             (white) is used in every theme (system-splash-theme, design D1). -->
        <activity
            android:name=".AurelexActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Aurelex"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Look up in Aurelex" from other apps' share sheets -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Explicit lookup intent, e.g. aurelex://lookup?word=<word> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="aurelex" android:host="lookup" />
            </intent-filter>
            <!-- Selection-toolbar lookup: "Look up in Aurelex" on selected text -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data android:name="android.app.lib_name" android:value="aurelex" />
            <meta-data android:name="android.app.extract_android_style" android:value="minimal" />
        </activity>

        <!-- QS tile: clipboard lookup funnel -->
        <service
            android:name=".AurelexTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile_lookup"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Bulk FTS indexing foreground service (bulk-fts-indexing): keeps the
             process foreground with an "Indexing..." notification while the
             automatic bulk index build runs, so long builds survive the app
             being backgrounded. Started/stopped by AurelexActivity. -->
        <service
            android:name=".IndexingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Dictionary-staging foreground service (folder-scoped-storage):
             copies a newly picked folder into app-private storage with a
             "Preparing dictionaries..." notification, so a large copy is not
             killed when the app is backgrounded. Started by AurelexActivity,
             stops itself when the copy + source registration complete. -->
        <service
            android:name=".StagingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Remote-catalog download foreground service: streams dictionary
             archives from the curated HTTPS catalog into app-private storage
             with a progress notification, so a multi-hundred-MB transfer
             survives the app being backgrounded. Writes its progress to
             shared_prefs/download.xml for the C++ poller and stops itself when
             the batch reaches a terminal outcome. -->
        <service
            android:name=".DictionaryDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Home-screen search widget -->
        <receiver
            android:name=".AurelexSearchWidget"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_info" />
        </receiver>
    </application>
</manifest>