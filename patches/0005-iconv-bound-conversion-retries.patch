       if ( errno == E2BIG || outBufLeft == 0 ) {
 
         if ( inBytesLeft > 0 ) {
+          // No progress => this input cannot be converted by retrying. Stop
+          // rather than grow the buffer and repeat identical work forever.
+          if ( inBytesLeft == bytesBefore ) {
+            break;
+          }
+
