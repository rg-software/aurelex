--- a/src/dict/stardict.cc
+++ b/src/dict/stardict.cc
@@ -26,6 +26,7 @@
 #include "utils.hh"
 #include <charconv>
 #include <QRegularExpression>
+#include <QUrl>
 #include "globalregex.hh"
 #include <QDir>
 
@@ -483,6 +484,25 @@ string StardictDictionary::handleResource( char type, const char * resource, siz
 
         QString link = match.captured( 3 );
 
+        // A bword: cross-reference reaches here with the scheme still attached:
+        // the regex's optional (bword://)? group does not match the two forms
+        // dictionaries actually use - "bword://Word" and, as The World Factbook
+        // emits, "bword:Word" with no slashes. Strip either so the test below
+        // sees the headword, not the scheme. Without this the link kept its
+        // ":" and fell through to the else branch, reaching the article as an
+        // inert "bword:Word" href that nothing consumes, so tapping it did
+        // nothing (stardict-bword-link-navigation).
+        static const QString bwordScheme = QStringLiteral( "bword:" );
+        static const QString bwordSchemeSlash = QStringLiteral( "bword://" );
+        if ( link.startsWith( bwordSchemeSlash ) ) {
+          link.remove( 0, bwordSchemeSlash.size() );
+        }
+        else if ( link.startsWith( bwordScheme ) ) {
+          link.remove( 0, bwordScheme.size() );
+        }
+
+        // The link is now a headword, so it must not contain a scheme of its own
+        // (an absolute URL is left exactly as the dictionary wrote it).
         if ( link.indexOf( ':' ) < 0 ) {
           //compatible with issue #567
           //such as bword://fl&#x205;k
@@ -492,7 +512,29 @@ string StardictDictionary::handleResource( char type, const char * resource, siz
 
           QString newLink;
           if ( link.indexOf( '#' ) < 0 ) {
-            newLink = QString( "<a" ) + match.captured( 1 ) + "href=\"bword:" + link + "\"";
+            // Rewrite to the scheme the app resolves, using the SAME shape the
+            // DSL reader already produces for its <ref> nodes: build the URL
+            // with QUrl rather than assembling a string. Three hand-written
+            // forms were all wrong, and each failure looked different:
+            //
+            //   "bword:<word>"     - no consumer understands it; tap did nothing.
+            //   "gdlookup:<word>"  - bare scheme, an unknown URL; the WebView
+            //                        offered it to the system and the app
+            //                        reported "unknown url scheme".
+            //   "gdlookup:///<word>" - recognised, but with an EMPTY authority,
+            //                        so the word was mangled at the space and
+            //                        only "Afghanistan" reached the lookup.
+            //
+            // DSL emits "gdlookup://localhost/<encoded word>" and its refs
+            // navigate correctly on device, so matching that construction is the
+            // reliable option: setHost("localhost") keeps the authority
+            // non-empty and toEncoded() percent-encodes the path, which is what
+            // the app's _parseGdlookupUrl expects to decodeURIComponent.
+            QUrl url;
+            url.setScheme( QStringLiteral( "gdlookup" ) );
+            url.setHost( QStringLiteral( "localhost" ) );
+            url.setPath( Utils::Url::ensureLeadingSlash( link ) );
+            newLink = QString( "<a" ) + match.captured( 1 ) + "href=\"" + url.toEncoded() + "\"";
           }
 
 
