 #include "dict/dictionary.hh"
 #include "btreeidx.hh"
 #include "fulltextsearch.hh"
@@ -12,6 +13,12 @@ namespace FtsHelpers {
 
 bool ftsIndexIsOldOrBad( BtreeIndexing::BtreeDictionary * dict );
 
+// Aurelex patch (0004): cooperative slicing. When set, makeFTSIndex() calls the
+// hook periodically (bounded by a wall-clock slice) so the caller can briefly
+// release its engine lock and let other work interleave with the build. The
+// hook runs on the build thread; pass an empty function to clear it.
+void setYieldCallback( std::function< void() > cb );
+
